{
    "name":  "deepseek-plus-plus",
    "description":  "Agentic memory, skills, agentic execution, automation, and MCP tools for DeepSeek",
    "private":  true,
    "license":  "Apache-2.0",
    "version":  "1.16.0",
    "type":  "module",
    "workspaces":  [
                       "packages/*"
                   ],
    "scripts":  {
                    "dev":  "wxt",
                    "build":  "wxt build",
                    "build:chrome":  "wxt build --browser chrome",
                    "build:edge":  "wxt build --browser edge",
                    "build:firefox":  "wxt build --browser firefox --mv3",
                    "build:all":  "npm run build:chrome \u0026\u0026 npm run build:edge \u0026\u0026 npm run build:firefox",
                    "reload":  "python tools/reload-extension.py",
                    "build:reload":  "npm run build:chrome \u0026\u0026 python tools/reload-extension.py",
                    "test:cdp":  "python tools/cdp-g1-test.py",
                    "zip":  "wxt zip",
                    "zip:chrome":  "wxt zip --browser chrome",
                    "zip:edge":  "wxt zip --browser edge",
                    "zip:firefox":  "wxt zip --browser firefox --mv3",
                    "zip:sources":  "node scripts/package-sources.mjs",
                    "zip:all":  "npm run zip:chrome \u0026\u0026 npm run zip:edge \u0026\u0026 npm run zip:firefox \u0026\u0026 npm run zip:sources",
                    "submit:chrome:dry":  "wxt submit --dry-run --chrome-zip dist/deepseek-plus-plus-$npm_package_version-chrome.zip",
                    "submit:chrome:upload":  "wxt submit --chrome-zip dist/deepseek-plus-plus-$npm_package_version-chrome.zip --chrome-skip-submit-review",
                    "submit:chrome":  "wxt submit --chrome-zip dist/deepseek-plus-plus-$npm_package_version-chrome.zip --chrome-publish-target default",
                    "test":  "vitest run",
                    "compile":  "tsc --noEmit",
                    "eval:golden":  "node tools/eval/build-fixtures.mjs \u0026\u0026 node tools/eval/golden-runner.mjs",
                    "audit:prod":  "npm audit --audit-level=high --omit=dev",
                    "verify:workflows":  "actionlint",
                    "verify:manifest-policy":  "node scripts/manifest-policy-check.mjs",
                    "verify:extension-utf8":  "node scripts/verify-extension-utf8.mjs",
                    "verify:sidepanel-chunks":  "node scripts/sidepanel-chunk-budget.mjs",
                    "verify:release-assets":  "node scripts/release-assets-check.mjs",
                    "verify:bundled-skills":  "node scripts/bundled-skill-package-check.mjs",
                    "smoke:pyodide":  "node scripts/pyodide-offline-smoke.mjs",
                    "verify:persistence-burst":  "vitest run tests/persistence-burst-budget.test.ts --reporter=verbose",
                    "verify:i18n":  "node scripts/i18n-locale-check.mjs \u0026\u0026 node scripts/i18n-coverage-audit.mjs",
                    "verify:test-collection":  "node scripts/verify-test-collection.mjs",
                    "verify:extensions-version":  "node scripts/verify-extensions-version.mjs",
                    "ci:quality":  "npm run verify:workflows \u0026\u0026 npm run audit:prod \u0026\u0026 npm run prompt:freeze \u0026\u0026 npm run compile \u0026\u0026 npm run verify:test-collection \u0026\u0026 node scripts/test-with-baseline.mjs \u0026\u0026 npm run verify:persistence-burst \u0026\u0026 npm run verify:i18n \u0026\u0026 npm run verify:automation \u0026\u0026 npm run smoke:mcp \u0026\u0026 npm run verify:mcp:mock \u0026\u0026 npm run smoke:shell \u0026\u0026 npm run smoke:pow \u0026\u0026 npm run smoke:web \u0026\u0026 npm run build:all \u0026\u0026 npm run pi:bundle-budget \u0026\u0026 npm run verify:extensions-version \u0026\u0026 npm run verify:bundled-skills \u0026\u0026 npm run verify:sidepanel-chunks \u0026\u0026 npm run verify:extension-utf8 \u0026\u0026 npm run verify:manifest-policy \u0026\u0026 npm run zip:all \u0026\u0026 npm run verify:release-assets \u0026\u0026 npm run smoke:pyodide",
                    "shell:install":  "node scripts/install-shell-host.mjs",
                    "multimodal:install":  "npx --yes deepseek-pp-multimodal-mcp@0.1.0",
                    "smoke:pow":  "node scripts/pow-smoke.mjs",
                    "smoke:web":  "node scripts/web-search-smoke.mjs",
                    "pi:bundle-budget":  "node scripts/pi-bundle-budget.mjs",
                    "prompt:freeze":  "node scripts/prompt-freeze.mjs",
                    "prompt:freeze:update":  "node scripts/prompt-freeze.mjs --update",
                    "smoke:shell":  "node scripts/shell-smoke.mjs",
                    "smoke:mcp":  "node scripts/mcp-smoke.mjs",
                    "verify:automation":  "node scripts/automation-contract-smoke.mjs",
                    "verify:mcp:mock":  "node scripts/mcp-live-mock.mjs",
                    "postinstall":  "wxt prepare"
                },
    "dependencies":  {
                         "@earendil-works/pi-agent-core":  "0.83.0",
                         "pyodide":  "314.0.0",
                         "react":  "^19.2.4",
                         "react-dom":  "^19.2.4",
                         "react-markdown":  "^10.1.0",
                         "sucrase":  "^3.35.1"
                     },
    "devDependencies":  {
                            "@babel/parser":  "^7.29.2",
                            "@babel/types":  "^7.29.0",
                            "@tailwindcss/vite":  "^4.2.4",
                            "@types/chrome":  "^0.1.42",
                            "@types/react":  "^19.2.14",
                            "@types/react-dom":  "^19.2.3",
                            "@wxt-dev/module-react":  "^1.1.5",
                            "fake-indexeddb":  "^6.2.5",
                            "jsdom":  "^29.1.1",
                            "tailwindcss":  "^4.2.4",
                            "typescript":  "^7.0.2",
                            "vitest":  "^4.1.8",
                            "wxt":  "^0.20.26"
                        },
    "overrides":  {
                      "tmp":  "^0.2.7",
                      "uuid":  "^11.1.1",
                      "@earendil-works/pi-ai":  "0.83.0"
                  }
}
